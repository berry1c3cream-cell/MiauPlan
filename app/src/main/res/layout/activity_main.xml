<!--        android:layout_width="200dp"-->
<!--        android:layout_height="200dp"-->
<!--        android:layout_marginTop="60dp"-->
<!--        android:src="@drawable/ic_cat"-->
<!--        app:layout_constraintEnd_toEndOf="parent"-->
<!--        app:layout_constraintStart_toStartOf="parent"-->
<!--        app:layout_constraintTop_toBottomOf="@id/title" />-->

<!--    &lt;!&ndash; Texto &ndash;&gt;-->
<!--    <TextView-->
<!--        android:id="@+id/textInfo"-->
<!--        android:layout_width="wrap_content"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:layout_marginTop="16dp"-->
<!--        android:text="Aún no tienes ningún gato\n¡Agrega uno!"-->
<!--        android:textAlignment="center"-->
<!--        android:textColor="@color/negroRosa"-->
<!--        android:textSize="16sp"-->
<!--        app:layout_constraintEnd_toEndOf="parent"-->
<!--        app:layout_constraintStart_toStartOf="parent"-->
<!--        app:layout_constraintTop_toBottomOf="@id/catImage" />-->

    <!-- Boton agregar -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/addCat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="#9BB59F"
        app:layout_constraintTop_toBottomOf="@id/cardGato"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>