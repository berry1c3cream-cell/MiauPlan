<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F1F2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Título -->
        <TextView
            android:id="@+id/tvTituloVet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Visita al veterinario"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#3D3D3D"
            android:layout_marginBottom="20dp"/>

        <!-- Checkup -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardCheckup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#E9E1E3"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Checkup general"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#444444"/>

                <CheckBox
                    android:id="@+id/checkCheckup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="#D88C9A"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Desparasitación -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardDesparasitacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#E9E1E3"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Desparasitación"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#444444"/>

                <CheckBox
                    android:id="@+id/checkDesparasitacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="#D88C9A"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Baño -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardBano"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#E9E1E3"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Baño"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#444444"/>

                <CheckBox
                    android:id="@+id/checkBano"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="#D88C9A"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Corte de uñas -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardUnas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#E9E1E3"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Corte de uñas"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#444444"/>

                <CheckBox
                    android:id="@+id/checkUnas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="#D88C9A"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Revisión médica -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardRevision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#E9E1E3"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Revisión médica"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#444444"/>

                <CheckBox
                    android:id="@+id/checkRevision"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="#D88C9A"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Vacunas -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardVacunas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#E9E1E3"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Le tocaban vacunas"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#444444"/>

                <CheckBox
                    android:id="@+id/checkVacunas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="#D88C9A"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Botones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnGuardar"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="Guardar"
                android:textColor="#FFFFFF"
                android:backgroundTint="#A35A66"
                android:layout_marginEnd="12dp"/>

            <Button
                android:id="@+id/btnCancelar"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="Cancelar"
                android:textColor="#FFFFFF"
                android:backgroundTint="#7B5CC9"/>
        </LinearLayout>

    </LinearLayout>

</ScrollView>